{
  "name": "zen-3d-explainer-shorts",
  "version": "1.0.0",
  "private": true,
  "description": "Reference-driven 30 fps low-poly 3D cutaway explainers for Claude Code",
  "license": "MIT",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts DioramaShort out/demo.mp4 --codec h264 --crf 17 --gl angle --concurrency 1",
    "still": "remotion still src/index.ts DioramaShort out/still.png --frame 135 --gl angle",
    "stills": "node templates/scripts/stills.mjs",
    "publish:github": "node templates/scripts/publish-github.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.1.2",
    "@remotion/cli": "4.0.290",
    "@remotion/three": "4.0.290",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.290",
    "three": "0.175.0"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.290",
    "@remotion/renderer": "4.0.290",
    "@types/node": "22.14.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@types/three": "0.175.0",
    "typescript": "5.8.3"
  }
}
